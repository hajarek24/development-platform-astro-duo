# Ignore node_modules (dependencies will be installed in the container)
node_modules

# Ignore build output (it will be generated in the container)
dist
build

# Ignore environment files
.env
.env.local
.env.*.local

# Ignore logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore Git files
.git
.gitignore

# Ignore Docker-related files
Dockerfile
.dockerignore

# Ignore IDE/editor configuration files
.vscode
.idea
*.swp

# Ignore miscellaneous files
.DS_Store
Thumbs.db