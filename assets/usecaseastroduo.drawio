        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml Space Gateway Use Case Diagram\n\nleft to right direction\nskinparam actorStyle awesome\nskinparam usecase {\n  BackgroundColor LightBlue\n  BorderColor DarkBlue\n  ArrowColor DarkBlue\n  FontName Arial\n}\n\nactor \&quot;User\&quot; as user\n\nrectangle \&quot;Space Gateway System\&quot; {\n  &#39; Main use cases\n  usecase \&quot;Browse Planets\&quot; as BrowsePlanets\n  usecase \&quot;View Planet Details\&quot; as ViewPlanetDetails\n  usecase \&quot;View NASA Picture of the Day\&quot; as ViewPOTD\n  usecase \&quot;Explore Space\&quot; as ExploreSpace\n  usecase \&quot;View Articles\&quot; as ViewArticles\n  usecase \&quot;View Images\&quot; as ViewImages\n  usecase \&quot;Learn About Project\&quot; as LearnAboutProject\n  \n  &#39; Sub use cases for Explore Space\n  usecase \&quot;Explore Current Missions\&quot; as ExploreMissions\n  usecase \&quot;Explore Upcoming Events\&quot; as ExploreEvents\n  usecase \&quot;Explore Space News\&quot; as ExploreNews\n  \n  &#39; Search functionality\n  usecase \&quot;Search Content\&quot; as SearchContent\n  \n  &#39; Extended use cases\n  BrowsePlanets ..&gt; ViewPlanetDetails : &lt;&lt;extend&gt;&gt;\n  \n  &#39; Include relationships\n  ExploreSpace ..&gt; ExploreMissions : &lt;&lt;include&gt;&gt;\n  ExploreSpace ..&gt; ExploreEvents : &lt;&lt;include&gt;&gt;\n  ExploreSpace ..&gt; ExploreNews : &lt;&lt;include&gt;&gt;\n  \n  &#39; Search functionality is included in various features\n  ViewArticles ..&gt; SearchContent : &lt;&lt;include&gt;&gt;\n  ViewImages ..&gt; SearchContent : &lt;&lt;include&gt;&gt;\n  ExploreSpace ..&gt; SearchContent : &lt;&lt;include&gt;&gt;\n  \n  &#39; User interactions\n  user --&gt; BrowsePlanets\n  user --&gt; ViewPOTD\n  user --&gt; ExploreSpace\n  user --&gt; ViewArticles\n  user --&gt; ViewImages\n  user --&gt; LearnAboutProject\n}\n\n@enduml\n\n\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="V7A7QUbbNbbhTnkEf8Ch-1">
